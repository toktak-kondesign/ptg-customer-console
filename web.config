<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="4294967295" />
        <fileExtensions allowUnlisted="true" />
        <verbs allowUnlisted="true" />
        <hiddenSegments>
          <clear />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <!-- 1. Next.js Image Optimizer → ส่งไป Node (ชัดเจน ป้องกันถูก catch-all กินก่อน) -->
        <rule name="NextImageOptimizer" stopProcessing="true">
          <match url="^_next/image/(.*)$" />
          <action type="Rewrite" url="http://localhost:3302/_next/image/{R:1}" />
        </rule>

        <!-- 2. catch-all ส่งทุก request ไป Node (เดิม) -->
        <rule name="Proxy to PM2 NextJS" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3302/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
