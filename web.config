<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!--
      ปิด IIS HTTP Redirect feature ที่นี่ เผื่อมีการตั้งค่าไว้ก่อนหน้า
      (parent web.config หรือ IIS Manager UI) ที่ redirect request ทุกตัว
      กลับไปที่ path เดิม ทำให้เกิด NS_ERROR_REDIRECT_LOOP
    -->
    <httpRedirect enabled="false" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="4294967295" />
        <fileExtensions allowUnlisted="true" />
        <verbs allowUnlisted="true" />
        <hiddenSegments>
          <clear />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <!--
          Next.js ตั้ง basePath: "/Customer-console" ไว้ (ดู next.config.ts)
          IIS Application นี้ scope เฉพาะ /Customer-console/ ทำให้ URL Rewrite
          จับ path แบบ relative กับ app (prefix ถูกตัดออกไปแล้วโดย IIS)
          จึงต้องเติม /Customer-console กลับเข้าไปตอน forward ไป Node
          ไม่งั้น Next.js จะปฏิเสธ request ที่ไม่มี basePath prefix (404)
        -->

        <!-- 1. Next.js Image Optimizer → ส่งไป Node -->
        <rule name="NextImageOptimizer" stopProcessing="true">
          <match url="^_next/image/(.*)$" />
          <action type="Rewrite" url="http://localhost:3302/Customer-console/_next/image/{R:1}" />
        </rule>

        <!-- 2. catch-all ส่งทุก request ไป Node พร้อม basePath prefix -->
        <rule name="Proxy to PM2 NextJS" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3302/Customer-console/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
