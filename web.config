<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS Reverse Proxy config สำหรับ Next.js บน port 3302
  วางไฟล์นี้ที่ root ของ site ใน IIS (เดียวกับที่วาง .next/ และ public/)

  ** ข้อกำหนด (ติดตั้งก่อนใช้งาน) **
  1. URL Rewrite module:        https://www.iis.net/downloads/microsoft/url-rewrite
  2. Application Request Routing (ARR): https://www.iis.net/downloads/microsoft/application-request-routing
  3. เปิด proxy ที่ server level:
     IIS Manager → Server node → Application Request Routing Cache
     → Server Proxy Settings → ✅ Enable proxy → Apply
-->
<configuration>
  <system.webServer>
    <!-- เปิด reverse proxy สำหรับ site นี้ -->
    <proxy enabled="true" preserveHostHeader="false" />

    <rewrite>
      <!-- อนุญาตให้ set serverVariables ใน rewrite rules -->
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_HOST" />
        <add name="HTTP_X_FORWARDED_PROTO" />
      </allowedServerVariables>

      <rules>
        <!--
          1. Next.js Image Optimizer → ส่งไป Node
          แก้ปัญหา /_next/image?url=...&w=...&q=... ที่ IIS หาไฟล์ไม่เจอ 404
        -->
        <rule name="NextImageOptimizer" stopProcessing="true">
          <match url="^_next/image/(.*)$" />
          <action type="Rewrite" url="http://localhost:3302/_next/image/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>

        <!--
          2. API routes → ส่งไป Node
          /api/* ทั้งหมด (approve-link, customer, auth, ptg)
        -->
        <rule name="NextApi" stopProcessing="true">
          <match url="^api/(.*)$" />
          <action type="Rewrite" url="http://localhost:3302/api/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>

        <!--
          3. Dynamic page routes → ส่งไป Node
          ยกเว้น static paths ที่ IIS serve เอง:
          - _next/static/*  (compiled JS/CSS)
          - images/*, logo/*, webfont/*  (จาก public/)
          - favicon.ico, robots.txt
        -->
        <rule name="NextDynamic" stopProcessing="true">
          <match url="^(?!_next/static|images|logo|webfont|favicon\.ico|robots\.txt)(.*)$" />
          <action type="Rewrite" url="http://localhost:3302/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
