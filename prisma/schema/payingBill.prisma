// ตารางนี้อยู่บนฐาน PTGDATACENTER (คนละเซิร์ฟเวอร์กับ DATABASE_URL)
// ต้องเรียกผ่าน `prismaDataCenter` (lib/prismaDataCenter.ts) เท่านั้น
model PtgPayingBill {
  itemId              Int       @id @default(autoincrement()) @map("itemid")
  runno               String?   @map("Runno") @db.NVarChar(12)
  company             String?   @map("company") @db.NVarChar(10)
  custId13            String?   @map("Custid13") @db.NVarChar(50)
  custId              String?   @map("CustID") @db.NVarChar(20)
  branchId            String?   @map("BranchID") @db.NVarChar(50)
  vanNo               String?   @map("VANNO") @db.NVarChar(50)
  type                String?   @map("Type") @db.NVarChar(50)
  amount              Float?    @map("AMOUNT")
  bankType            String?   @map("BankType") @db.NVarChar(50)
  bankReceipt         String?   @map("BankReceipt") @db.NVarChar(50)
  checkNo             String?   @map("CheckNo") @db.NVarChar(30)
  billDate            DateTime? @map("Billdate") @db.Date
  tranferTime         String?   @map("TranferTime") @db.NVarChar(10)
  typeBill            String?   @map("typeBill") @db.NVarChar(10)
  receiveDate         DateTime? @map("receivedate") @db.Date
  bankBranch          String?   @map("bankbranch") @db.NVarChar(100)
  createDate          DateTime? @map("Createdate") @db.DateTime
  userCreate          String?   @map("UserCreate") @db.NVarChar(100)
  isActive            Int       @default(0) @map("isactive")
  chequeStatus        String?   @map("chequeStatus") @db.NVarChar(2)
  dateChequeReceipt01 DateTime? @map("DateChequeReceipt01") @db.DateTime
  dateChequeReceipt02 DateTime? @map("DateChequeReceipt02") @db.DateTime
  receiptPerson       String?   @map("ReceiptPerson") @db.NVarChar(100)
  receiptPerson02     String?   @map("ReceiptPerson02") @db.NVarChar(100)
  remarkCancer        String?   @map("remarkCancer") @db.NVarChar(500)
  receivingType       Int?      @map("Receivingtype")

  @@map("PTGPayingBill")
}
